---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import ArticleSchema from '@/components/seo/ArticleSchema.astro'
import Header from '@/components/ui/Header.astro'
import Footer from '@/components/ui/Footer.astro'
import Main from '@/components/ui/Main.astro'
import type { Post } from '@/types'
import googleSansFont from '@/assets/fonts/google-sans-flex.woff2'
import yellowtailFont from '@/assets/fonts/yellowtail.woff2'
import WhatsappFab from '@/components/ui/WhatsappFab.astro'

import JsonLdSchemas from '@/seo/JsonLdSchemas.astro'
import organization from '@/seo/organization'
import website from '@/seo/website'
import { site } from '@/data/site'

interface Props {
  title?: string
  description?: string
  image?: string
  article?: Post
  jsonLdSchemas?: Array<{ [key: string]: unknown }>
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  image = new URL(site.ogImagePath, Astro.site).href,
  article = undefined,
  jsonLdSchemas = [],
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href={googleSansFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={yellowtailFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.legalName}
      href={new URL('rss.xml', Astro.site)}
    />
    <title>{title}</title>
    {
      article && (
        <ArticleSchema
          title={article.title}
          description={article.description}
          slug={article.slug}
          publishedAt={article.publishedAt}
          updatedAt={article.updatedAt}
          coverImageUrl={article.coverImage?.url}
        />
      )
    }
    <JsonLdSchemas schemas={[organization, website, ...jsonLdSchemas]} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <Header />
    <Main>
      <section class="relative isolate">
        <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
          <div
            class="absolute -left-40 -top-40 size-128 rounded-full bg-primary/10 blur-3xl">
          </div>
          <div
            class="absolute -right-40 top-1/3 size-112 rounded-full bg-primary/8 blur-3xl">
          </div>
          <div
            class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-primary/30 to-transparent">
          </div>
        </div>
        <slot />
        <WhatsappFab />
      </section>
    </Main>
    <Footer />
    <script>
      function saveBlogHistory() {
        const path = window.location.pathname

        // Normaliza removendo a barra no final, exceto se for a raiz
        const cleanPath =
          path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path

        // Salva apenas rotas de listagem (ex: /blog ou /blog/page/3)
        if (cleanPath === '/blog' || cleanPath.startsWith('/blog/page/')) {
          sessionStorage.setItem('lastBlogListPath', cleanPath)
        }
      }

      document.addEventListener('astro:page-load', saveBlogHistory)
    </script>
  </body>
</html>
