---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import onestFont from '@/assets/fonts/onest.woff2'
import { site } from '@/data/site'

const {
  title = '404',
  description = site.defaultDescription,
} = Astro.props
---

<!doctype html>
<html lang="pt-BR" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={onestFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter fallback="swap" />

    <!-- Script Inline executado imediatamente antes do render -->
    <script is:inline>
      function applyTheme() {
        const localStorageTheme = localStorage.getItem('theme')
        const systemPrefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches

        if (
          localStorageTheme === 'dark' ||
          (!localStorageTheme && systemPrefersDark)
        ) {
          document.documentElement.classList.add('dark')
        } else {
          document.documentElement.classList.remove('dark')
        }
      }

      // 1. Executa na primeira renderização
      applyTheme()

      // 2. Re-executa após cada navegação via ClientRouter (View Transitions)
      document.addEventListener('astro:after-swap', applyTheme)
    </script>
  </head>
  <body class="h-full">
    <slot />
  </body>
</html>
