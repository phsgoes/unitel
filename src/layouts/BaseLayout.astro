---
import '@/styles/global.css'

import LazyClientRouter from '@/components/transitions/LazyClientRouter.astro'
import onestFont from '@/assets/fonts/onest.woff2'

import GoogleAnalytics from '@/components/analytics/GoogleAnalytics.astro'

import { site } from '@/data/site'

interface Props {
  title?: string
  description?: string
  htmlClass?: string
}

const { title = site.defaultTitle, description = site.defaultDescription, htmlClass = '' } = Astro.props
---

<!doctype html>
<html lang="pt-BR" class={htmlClass}>
  <head>
    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('theme') || localStorage.getItem('color-mode')
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches

        if (stored === 'dark' || (!stored && systemPrefersDark)) {
          document.documentElement.classList.add('dark')
        } else {
          document.documentElement.classList.remove('dark')
        }
      }

      applyTheme()

      document.addEventListener('astro:after-swap', applyTheme)
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={onestFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <GoogleAnalytics />
    <LazyClientRouter fallback="none" />
  </head>

  <body>
    <slot />
  </body>
</html>

