---
import BaseLayout from './BaseLayout.astro'

import ogUnitelImage from '@/assets/images/og-unitel.png'

import WhatsappFab from '@/components/ui/WhatsappFab.astro'
import Header from '@/components/ui/Header.astro'
import Footer from '@/components/ui/Footer.astro'
import Main from '@/components/ui/Main.astro'

import JsonLdSchemas from '@/seo/JsonLdSchemas.astro'
import organization from '@/seo/organization'
import website from '@/seo/website'
import { site } from '@/data/site'

interface Props {
  title?: string
  description?: string
  image?: string
  imageType?: string
  imageWidth?: number
  imageHeight?: number
  canonicalUrl?: string
  preloadImage?:
    | string
    | {
        src: string
        srcset?: string
        sizes?: string
      }
  jsonLdSchemas?: Array<{
    [key: string]: unknown
  }>
}

const defaultOgImage = new URL(ogUnitelImage.src, Astro.site).href

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  image = defaultOgImage,
  imageType = 'image/png',
  imageWidth = ogUnitelImage.width || 1200,
  imageHeight = ogUnitelImage.height || 630,
  canonicalUrl = `${new URL(Astro.url.pathname, Astro.site)}`,
  preloadImage = undefined,
  jsonLdSchemas = [],
} = Astro.props
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={site.legalName} href={new URL('rss.xml', Astro.site)} />
    {
      preloadImage && typeof preloadImage === 'string' && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }
    {
      preloadImage && typeof preloadImage === 'object' && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.src}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    <JsonLdSchemas schemas={[organization, website, ...jsonLdSchemas]} />
  </Fragment>
  <Header />
  <Main>
    <section class="relative isolate">
      <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
        <div class="absolute -left-40 -top-40 size-128 rounded-full bg-primary/10 blur-3xl"></div>
        <div class="absolute -right-40 top-1/3 size-112 rounded-full bg-primary/8 blur-3xl"></div>
        <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-primary/30 to-transparent"></div>
      </div>
      <slot />
      <WhatsappFab />
    </section>
    <Footer />
  </Main>
</BaseLayout>
