---
import BlankLayout from '@/layouts/BlankLayout.astro'
import { Icon } from 'astro-icon/components'
---

<BlankLayout title={`404`}>
  <main
    class="grid min-h-full place-items-center bg-white px-6 py-24 sm:py-32 lg:px-8 dark:bg-gray-900">
    <div class="max-w-md text-center">
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="mx-auto size-20 text-gray-400 dark:text-gray-500">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15.182 16.318A4.486 4.486 0 0 0 12.016 15a4.486 4.486 0 0 0-3.198 1.318M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z"
        ></path>
      </svg>

      <h2 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
        Hmm, não encontramos nada..
      </h2>

      <p class="mt-4 text-pretty text-gray-700 dark:text-gray-200">
        Não encontramos o que você estava procurando. Tente diferentes termos de
        busca ou procure o seu conteúdo em nossas páginas.
      </p>

      <div class="mt-6">
        <a
          href="/"
          class="block w-full rounded-lg border border-indigo-600 px-6 py-3 text-sm font-medium text-indigo-600 transition-colors hover:bg-indigo-50 dark:border-gray-800 dark:text-white dark:hover:bg-gray-800">
          Voltar para a Home
        </a>
      </div>

      <p class="mt-6 text-sm text-gray-700 dark:text-gray-200">
        Outras páginas:
        <a
          href="/solucoes"
          class="text-indigo-600 hover:underline dark:text-indigo-300 mx-4"
          >Soluções</a
        >
        <a
          href="/blog"
          class="text-indigo-600 hover:underline dark:text-indigo-300 mr-4"
          >Blog</a
        >
        <a
          href="contato"
          class="text-indigo-600 hover:underline dark:text-indigo-300"
          >Contato</a
        >
      </p>
    </div>
    <!-- <div class="text-center">
      <p class="text-base font-semibold text-indigo-600 dark:text-indigo-400">
        404
      </p>
      <h1
        class="mt-4 text-5xl font-semibold tracking-tight text-balance text-gray-900 sm:text-7xl dark:text-white">
