---
import PageLayout from '@/layouts/PageLayout.astro'
import SolutionPageView from '@/components/solucoes/SolutionPageView.astro'
import { callCenterPage } from '@/data/solucoes/call-center'
import { buildSolutionPageHead } from '@/utils/solutionPage'

const serviceImage = new URL(callCenterPage.hero.image.src, Astro.site).href
const head = buildSolutionPageHead(callCenterPage, serviceImage)
---

<PageLayout {...head}>
  <SolutionPageView page={callCenterPage} />
</PageLayout>
