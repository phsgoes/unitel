---
import PageLayout from '@/layouts/PageLayout.astro'
import SolutionPageView from '@/components/solucoes/SolutionPageView.astro'
import { ouvidoriaDigitalPage } from '@/data/solucoes/ouvidoria-digital'
import { buildSolutionPageHead } from '@/utils/solutionPage'

const serviceImage = new URL(ouvidoriaDigitalPage.hero.image.src, Astro.site)
  .href
const head = buildSolutionPageHead(ouvidoriaDigitalPage, serviceImage)
---

<PageLayout {...head}>
  <SolutionPageView page={ouvidoriaDigitalPage} />
</PageLayout>
