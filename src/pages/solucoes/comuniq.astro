---
import PageLayout from '@/layouts/PageLayout.astro'
import SolutionPageView from '@/components/solucoes/SolutionPageView.astro'
import { comuniqPage } from '@/data/solucoes/comuniq'
import { buildSolutionPageHead } from '@/utils/solutionPage'

const serviceImage = new URL(comuniqPage.hero.image.src, Astro.site).href
const head = buildSolutionPageHead(comuniqPage, serviceImage)
---

<PageLayout {...head}>
  <SolutionPageView page={comuniqPage} />
</PageLayout>
