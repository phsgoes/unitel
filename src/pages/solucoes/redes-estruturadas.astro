---
import PageLayout from '@/layouts/PageLayout.astro'
import SolutionPageView from '@/components/solucoes/SolutionPageView.astro'
import { redesEstruturadasPage } from '@/data/solucoes/redes-estruturadas'
import { buildSolutionPageHead } from '@/utils/solutionPage'

const serviceImage = new URL(redesEstruturadasPage.hero.image.src, Astro.site)
  .href
const head = buildSolutionPageHead(redesEstruturadasPage, serviceImage)
---

<PageLayout {...head}>
  <SolutionPageView page={redesEstruturadasPage} />
</PageLayout>
