---
import PageLayout from '@/layouts/PageLayout.astro'

import { Image, getImage } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { storyItems } from '@/data/story'
import officeBackground from '@/assets/images/office-background.avif'
import testimonials from '@/data/testimonials'

import SocialProof from '@/components/ui/SocialProof.astro'
import StoryReveal from '@/components/ui/StoryReveal.astro'
import LogoUnitel from '@/components/ui/LogoUnitel.astro'
import Testimonials from '@/components/ui/Testimonials.astro'

const heroOptimized = await getImage({
  src: officeBackground,
  widths: [640, 1024, 1440, 1920],
  sizes: '100vw',
  format: 'avif',
  quality: 'low',
})
---

<PageLayout
  title="Home"
  preloadImage={{
    src: heroOptimized.src,
    srcset: heroOptimized.srcSet.attribute,
    sizes: '100vw',
  }}>
  <section class="relative h-screen w-full overflow-hidden bg-neutral-900">
    <Image
      src={officeBackground}
      alt=""
      aria-hidden="true"
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      quality="low"
      format="avif"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/65"></div>
    <div class="relative z-10 flex h-full items-center justify-center px-6 text-center sm:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="sr-only">Unitel Telecomunicações</h1>
        <LogoUnitel dark role="img" aria-label="Unitel Telecomunicações" />
        <p class="mx-auto mt-12 max-w-2xl text-lg font-medium text-white md:text-xl">
          Soluções especializada em projetos de telecomunicações, consultoria, telefonia digital IP, redes estruturadas
          e softwares de Call Center.
        </p>
      </div>
    </div>
  </section>
  <SocialProof />
  <StoryReveal items={storyItems} />
  <Testimonials testimonials={testimonials} />
  <section class="relative isolate overflow-hidden bg-default px-6 py-24 sm:py-32 lg:px-8">
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,var(--color-indigo-100),white)] opacity-20 dark:bg-[radial-gradient(45rem_50rem_at_top,var(--color-indigo-500),transparent)] dark:opacity-10">
    </div>
    <div
      class="absolute inset-y-0 right-1/2 -z-10 mr-16 w-[200%] origin-bottom-left skew-x-[-30deg] bg-white shadow-xl ring-1 shadow-indigo-600/10 ring-indigo-50 sm:mr-28 lg:mr-0 xl:mr-16 xl:origin-center dark:bg-gray-900 dark:shadow-indigo-500/5 dark:ring-white/5">
    </div>
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="mt-5 text-3xl font-bold tracking-tight text-default sm:text-4xl lg:text-5xl">
        Sua empresa está preparada para crescer?
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-toned sm:text-lg">
        Converse com um especialista da Unitel e descubra como aplicar soluções adequadas ao seu tamanho, aos processos
        e aos objetivos do seu negócio.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/solucoes"
          data-analytics-link
          data-analytics-type="cta"
          data-analytics-label="Quero conhecer as soluções da Unitel"
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-orange-700 px-7 py-4 text-sm font-bold text-white shadow-xl shadow-orange-700/20 transition duration-300 hover:-translate-y-0.5 hover:bg-orange-800">
          Quero conhecer as soluções da Unitel
          <Icon name="mdi:arrow-right" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
        </a>
        <a
          href="tel:+557721013300"
          data-analytics-link
          data-analytics-type="phone"
          data-analytics-label="Telefone Unitel"
          class="inline-flex items-center gap-2 rounded-full border border-slate-400 px-7 py-4 text-sm font-semibold text-default transition hover:bg-default">
          <Icon name="mdi:phone-outline" size={18} />
          (77) 2101-3300
        </a>
      </div>
      <p class="mt-7 text-sm text-toned">Atendimento especializado em Vitória da Conquista e região.</p>
    </div>
  </section>
</PageLayout>
