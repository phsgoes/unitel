---
import PageLayout from '@/layouts/PageLayout.astro'
import officeBackground from '@/assets/images/office-background.webp'
import { Image } from 'astro:assets'
import StoryReveal from '@/components/ui/StoryReveal.astro'
import { storyItems } from '@/data/story'
import LogoUnitel from '@/components/ui/LogoUnitel.astro'
import SocialProof from '@/components/ui/SocialProof.astro'
---

<PageLayout title="Home">
  <section class="relative h-screen w-full overflow-hidden bg-neutral-900">
    <Image
      src={officeBackground}
      alt=""
      aria-hidden="true"
      widths={[640, 1024, 1440, 1920, officeBackground.width]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={60}
      format="avif"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/65 backdrop-blur-xs"></div>
    <div
      class="relative z-10 flex h-full items-center justify-center px-6 text-center sm:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="sr-only">Unitel Telecomunicações</h1>
        <LogoUnitel dark role="img" aria-label="Unitel Telecomunicações" />
        <p class="mx-auto mt-12 max-w-2xl text-lg font-medium text-white md:text-xl">
          Soluções especializada em projetos de telecomunicações, consultoria,
          telefonia digital IP, redes estruturadas e softwares de Call Center.
        </p>
      </div>
    </div>
  </section>
  <SocialProof />
  <StoryReveal items={storyItems} />
</PageLayout>
