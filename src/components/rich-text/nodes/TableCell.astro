---
import type { RichTextNode } from '@/types'
import Node from '../Node.astro'

const { node, references } = Astro.props

const isHeader = node.type === 'table_header_cell' || node.header === true

const Tag = isHeader ? 'th' : 'td'
---

<Tag
  class:list={[
    'border border-zinc-200 px-4 py-3 text-left align-top dark:border-zinc-800',
    isHeader && 'bg-zinc-100 font-semibold dark:bg-zinc-900/25',
  ]}>
  {
    node.children?.map((child: RichTextNode) => (
      <Node node={child} references={references} />
    ))
  }
</Tag>
