---
import type { RichTextNode } from '@/types';
import Node from '../Node.astro';
import VideoEmbed from './VideoEmbed.astro';

const { node, references } = Astro.props;

const href = node.href ?? '';

function isExternalLink(href: string): boolean {
  try {
    // Links relativos pertencem ao próprio site
    if (
      href.startsWith('/') ||
      href.startsWith('#') ||
      href.startsWith('?')
    ) {
      return false;
    }

    const url = new URL(href, Astro.site ?? Astro.url);

    // mailto:, tel:, etc. não são links HTTP externos
    if (!['http:', 'https:'].includes(url.protocol)) {
      return false;
    }

    const siteUrl = Astro.site ?? Astro.url;

    return url.hostname !== siteUrl.hostname;
  } catch {
    return false;
  }
}

const isExternal = isExternalLink(href);

function isYouTubeVideo(url: string): boolean {
  try {
    const parsed = new URL(url);

    const hostname = parsed.hostname.toLowerCase();

    const isYouTube =
      hostname === 'youtube.com' ||
      hostname === 'www.youtube.com' ||
      hostname === 'm.youtube.com' ||
      hostname === 'youtu.be' ||
      hostname === 'www.youtu.be';

    if (!isYouTube) return false;

    // youtube.com/watch?v=...
    if (parsed.pathname === '/watch') {
      return Boolean(parsed.searchParams.get('v'));
    }

    // youtu.be/VIDEO_ID
    if (hostname.includes('youtu.be')) {
      return parsed.pathname.length > 1;
    }

    // youtube.com/shorts/VIDEO_ID
    if (parsed.pathname.startsWith('/shorts/')) {
      return parsed.pathname.split('/')[2]?.length > 0;
    }

    // youtube.com/embed/VIDEO_ID
    if (parsed.pathname.startsWith('/embed/')) {
      return parsed.pathname.split('/')[2]?.length > 0;
    }

    return false;
  } catch {
    return false;
  }
}

const isVideo = isYouTubeVideo(href);
---

{
  isVideo ? (
    <VideoEmbed node={node} />
  ) : (
    <a
      href={href}
      class="group inline-flex items-baseline gap-1 text-zinc-800 underline decoration-violet-400/50 decoration-1 underline-offset-4 transition-all duration-300 hover:text-violet-600 hover:decoration-violet-500 hover:decoration-2 dark:text-zinc-200 dark:decoration-violet-400/40 dark:hover:text-violet-300 dark:hover:decoration-violet-300 dark:hover:[text-shadow:0_0_18px_rgba(167,139,250,0.35)]"
      target={node.openInNewTab || isExternal ? '_blank' : undefined}
      rel={node.openInNewTab || isExternal ? 'noopener noreferrer' : undefined}
    >
      {
        node.children?.map((child: RichTextNode) => (
          <Node node={child} references={references} />
        ))
      }

      {
        isExternal && (
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            fill="none"
            class="mb-0.5 size-3.5 shrink-0 opacity-60 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-100"
          >
            <path
              d="M11.5 4H16v4.5M15.75 4.25l-7 7"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M16 11.5V15a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )
      }
    </a>
  )
}