---
import type { RichTextNode } from "@/types";
import Node from "../Node.astro";

const { node, references } = Astro.props;

const map = {
  "heading-one": "h1",
  "heading-two": "h2",
  "heading-three": "h3",
  "heading-four": "h4",
  "heading-five": "h5",
  "heading-six": "h6",
} as const;

// @ts-expect-error
const Tag = map[node.type];
const headingId = Array.isArray(references) && !!references.length
  ? references.find((ref) => ref.title === node.children[0].text)?.id
  : undefined;
---

<Tag
  id={headingId}
  class:list={[
    "font-bold tracking-tight scroll-mt-24",
    {
      "mt-12 mb-6 text-5xl": Tag === "h1",
      "mt-10 mb-5 text-4xl": Tag === "h2",
      "mt-8 mb-4 text-3xl": Tag === "h3",
      "mt-8 mb-4 text-2xl": Tag === "h4",
      "mt-6 mb-3 text-xl": Tag === "h5",
      "mt-6 mb-3 text-lg": Tag === "h6",
    },
  ]}
>
  {
    node.children?.map((child: RichTextNode) => (
      <Node
        node={child}
        references={references}
      />
    ))
  }
</Tag>