---
import { Icon } from 'astro-icon/components'
import type { ChallengeSection } from '@/types/solucao'

interface Props {
  section: ChallengeSection
}

const { section } = Astro.props
---

<section id={section.id ?? 'solucao'} class="scroll-mt-20 bg-default py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div>
        <span
          class="inline-flex rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-orange-600"
        >
          {section.badge}
        </span>
        <h2
          class="mt-5 max-w-xl text-3xl font-bold tracking-tight text-highlighted sm:text-4xl lg:text-5xl"
        >
          {section.title}
        </h2>
        <p class="mt-6 max-w-xl whitespace-pre-line text-base leading-8 text-toned">
          {section.description}
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          section.cards.map((card) => (
            <article class="rounded-3xl border border-slate-200 bg-default p-6 transition duration-300 hover:-translate-y-1 hover:border-orange-200 hover:bg-orange-50/30 hover:dark:bg-orange-500/80">
              <span class="flex size-11 items-center justify-center rounded-2xl bg-white text-orange-500 shadow-sm ring-1 ring-slate-200">
                <Icon name={card.icon} size={22} />
              </span>
              <h3 class="mt-5 text-lg font-bold text-default">{card.title}</h3>
              <p class="mt-3 text-sm leading-7 text-toned">{card.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
