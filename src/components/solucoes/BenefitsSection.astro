---
import { Icon } from 'astro-icon/components'
import type { BenefitsSection } from '@/types/solucao'

interface Props {
  section: BenefitsSection
}

const { section } = Astro.props
---

<section
  id={section.id ?? 'beneficios'}
  class="scroll-mt-20 bg-default py-20 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <span
        class="inline-flex rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-orange-700 dark:border-orange-800/60 dark:bg-orange-950/50 dark:text-orange-300"
      >
        {section.badge}
      </span>
      <h2
        class="mt-5 text-3xl font-bold tracking-tight text-default sm:text-4xl lg:text-5xl"
      >
        {section.title}
      </h2>
      <p class="mt-5 text-base leading-8 text-toned sm:text-lg">
        {section.description}
      </p>
    </div>
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        section.items.map((item) => (
          <article class="group rounded-3xl border border-slate-200 bg-default p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-orange-200 hover:shadow-xl hover:shadow-slate-900/5">
            <span class="flex size-12 items-center justify-center rounded-2xl bg-orange-50 text-orange-500 transition-colors duration-300 group-hover:bg-orange-500 group-hover:text-white">
              <Icon name={item.icon} size={23} />
            </span>
            <h3 class="mt-6 text-lg font-bold text-default">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-toned">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
