---
import type { ClientsSection } from '@/types/solucao'

interface Props {
  section: ClientsSection
}

const { section } = Astro.props
---

<section
  class="border-y border-slate-200 bg-default py-16 dark:border-slate-100/10"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="text-xs font-bold uppercase tracking-[0.2em] text-orange-700 dark:text-orange-300"
      >
        {section.badge}
      </span>
      <h2
        class="my-8 text-3xl font-bold tracking-tight text-default sm:text-4xl"
      >
        {section.title}
      </h2>
      <p class="text-lg leading-7 text-toned">{section.description}</p>
    </div>
    <div class="my-16 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {
        section.names.map((name) => (
          <div class="flex min-h-24 items-center justify-center rounded-2xl border border-default bg-elevated p-4 text-center text-sm font-semibold leading-5 text-default shadow-sm">
            {name}
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-center text-lg leading-7 text-toned">
      {section.footnote}
    </p>
  </div>
</section>
