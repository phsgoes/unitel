---
import { Icon } from 'astro-icon/components'
import type { CompareSection } from '@/types/solucao'

interface Props {
  section: CompareSection
}

const { section } = Astro.props
---

<section class="overflow-hidden bg-inverted py-20 sm:py-24 dark:bg-default">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex rounded-full border border-orange-400/20 bg-orange-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-orange-300"
      >
        {section.badge}
      </span>
      <h2
        class="mt-5 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        {section.title}
      </h2>
      <p class="mt-6 text-base leading-8 text-slate-50 sm:text-lg">
        {section.description}
      </p>
    </div>
    <div
      class="mx-auto mt-14 max-w-5xl overflow-hidden rounded-3xl border border-white/10 bg-white/3"
    >
      <div class="grid md:grid-cols-2">
        <div
          class="border-b border-white/10 p-7 md:border-b-0 md:border-r md:p-10"
        >
          <p
            class="text-xs font-bold uppercase tracking-[0.18em] text-slate-300"
          >
            {section.beforeLabel}
          </p>
          <ul class="mt-7 space-y-5">
            {
              section.beforeItems.map((item) => (
                <li class="flex items-start gap-3 text-sm text-slate-50">
                  <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-white/5 text-slate-500">
                    <span class="size-1.5 rounded-full bg-slate-500" />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="relative overflow-hidden p-7 md:p-10">
          <div
            class="absolute right-0 top-0 size-48 rounded-full bg-orange-500/10 blur-3xl"
          >
          </div>
          <p
            class="relative text-xs font-bold uppercase tracking-[0.18em] text-orange-400"
          >
            {section.afterLabel}
          </p>
          <ul class="relative mt-7 space-y-5">
            {
              section.afterItems.map((item) => (
                <li class="flex items-start gap-3 text-sm text-slate-50">
                  <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-orange-500 text-white">
                    <Icon name="mdi:check" size={12} />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
