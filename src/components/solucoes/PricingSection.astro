---
import { Icon } from 'astro-icon/components'
import type { PricingSection } from '@/types/solucao'

interface Props {
  section: PricingSection
}

const { section } = Astro.props
---

<section
  id={section.id ?? 'planos'}
  class="scroll-mt-20 bg-default py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-orange-600">
        {section.badge}
      </span>
      <h2
        class="mt-5 text-3xl font-bold tracking-tight text-default sm:text-4xl lg:text-5xl">
        {section.title}
      </h2>
      <p class="mt-5 text-base leading-8 text-toned sm:text-lg">
        {section.description}
      </p>
    </div>
    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        section.plans.map((plan) => (
          <article
            class:list={[
              'relative flex flex-col rounded-3xl border p-8',
              plan.highlighted
                ? 'border-orange-400 bg-orange-50/40 dark:bg-red-600/5 shadow-xl shadow-orange-500/10'
                : 'border-slate-200 bg-default',
            ]}>
            {plan.highlighted && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-orange-500 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-white">
                {plan.highlightLabel ?? 'Mais popular'}
              </span>
            )}
            <h3 class="text-xl font-bold text-default">{plan.name}</h3>
            <p class="mt-2 text-sm font-semibold text-orange-600">
              {plan.capacity}
            </p>
            {plan.audience && (
              <p class="mt-4 text-sm font-semibold text-highlighted">
                {plan.audience}
              </p>
            )}
            <p
              class:list={[
                'text-sm leading-7 text-toned',
                plan.audience ? 'mt-2' : 'mt-4',
              ]}>
              {plan.description}
            </p>
            {plan.features.length > 0 && (
              <ul class="mt-6 flex-1 space-y-3">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-toned">
                    <Icon
                      name="mdi:check"
                      size={16}
                      class="mt-0.5 shrink-0 text-orange-500"
                    />
                    {feature}
                  </li>
                ))}
              </ul>
            )}
            <a
              href={plan.ctaHref}
              class="mt-auto inline-flex items-center justify-center rounded-md bg-primary px-5 py-3 text-sm font-semibold text-inverted transition hover:bg-primary/90">
              {plan.ctaLabel}
            </a>
          </article>
        ))
      }
    </div>
    {
      section.comparison && (
        <div class="mt-16 overflow-x-auto rounded-3xl border border-slate-200">
          <table class="min-w-full text-left text-sm">
            <caption class="sr-only">
              Comparativo de recursos entre planos
            </caption>
            <thead class="bg-slate-100 dark:bg-slate-800">
              <tr>
                {section.comparison.headers.map((header) => (
                  <th
                    scope="col"
                    class="px-4 py-3 font-semibold text-highlighted">
                    {header}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {section.comparison.rows.map((row) => (
                <tr class="border-t border-slate-200">
                  <th scope="row" class="px-4 py-3 font-medium text-default">
                    {row.feature}
                  </th>
                  {row.values.map((value) => (
                    <td class="px-4 py-3 text-toned">{value}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    {
      section.footnote && (
        <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-7 text-toned">
          {section.footnote}
        </p>
      )
    }
  </div>
</section>
