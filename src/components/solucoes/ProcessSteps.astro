---
import type { ProcessSection } from '@/types/solucao'

interface Props {
  section: ProcessSection
}

const { section } = Astro.props
---

<section class="bg-default py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <span
        class="inline-flex rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-orange-700 dark:border-orange-800/60 dark:bg-orange-950/50 dark:text-orange-300"
      >
        {section.badge}
      </span>
      <h2
        class="mt-5 text-3xl font-bold tracking-tight text-default sm:text-4xl lg:text-5xl"
      >
        {section.title}
      </h2>
      <p class="mt-5 text-base leading-8 text-toned sm:text-lg">
        {section.description}
      </p>
    </div>
    <div
      class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-slate-300 bg-slate-300 dark:border-white/10 dark:bg-white/10 md:grid-cols-4"
    >
      {
        section.steps.map((step) => (
          <article class="bg-default p-7 lg:p-8">
            <span class="text-sm font-bold text-orange-700 dark:text-orange-400">{step.number}</span>
            <h3 class="mt-10 text-xl font-bold text-default">{step.title}</h3>
            <p class="mt-3 text-sm leading-7 text-toned">{step.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
