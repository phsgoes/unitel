---
import { Image } from 'astro:assets'
import type { ImageMetadata, UnresolvedImageTransform } from 'astro'
import type { HTMLAttributes } from 'astro/types'

type ImageSrc =
  | string
  | ImageMetadata
  | Promise<{ default: ImageMetadata }>
  | UnresolvedImageTransform

type Props = HTMLAttributes<'img'> & {
  src: ImageSrc
  alt: string
  width?: number | `${number}`
  height?: number | `${number}`
  containerClass?: string
  format?: string
  loading?: 'lazy' | 'eager'
  fetchpriority?: 'high' | 'low' | 'auto'
  [key: string]: any
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  containerClass = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  format = 'webp',
  ...restProps
} = Astro.props

const computedAspectRatio = width && height ? `${width} / ${height}` : undefined
---

<div
  class={`image-container skeleton ${containerClass}`}
  style={computedAspectRatio ? { aspectRatio: computedAspectRatio } : {}}>
  <Image
    src={src as any}
    alt={alt}
    width={width ? Number(width) : undefined}
    height={height ? Number(height) : undefined}
    class={`image-content ${className}`}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    format={format as any}
    onload="this.closest('.image-container')?.classList.remove('skeleton')"
    {...restProps}
  />
</div>


<style>
  @reference "@/styles/global.css";

  .image-container.skeleton {
    @apply bg-slate-900/3 dark:bg-white/3;
    position: relative;
    overflow: hidden;
  }

  .image-container.skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.02) 20%,
      rgba(0, 0, 0, 0.06) 60%,
      transparent 100%
    );
    animation: shimmer 1.5s infinite;
    z-index: 10;
    pointer-events: none;
  }

  .dark .image-container.skeleton::after {
    background-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.03) 20%,
      rgba(255, 255, 255, 0.08) 60%,
      transparent 100%
    );
  }

  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
</style>
