---
import { Image } from 'astro:assets'
import type { ImageMetadata, UnresolvedImageTransform } from 'astro'
import type { HTMLAttributes } from 'astro/types'

type ImageSrc =
  | string
  | ImageMetadata
  | Promise<{ default: ImageMetadata }>
  | UnresolvedImageTransform

type Props = HTMLAttributes<'img'> & {
  src: ImageSrc
  alt: string
  width?: number | `${number}`
  height?: number | `${number}`
  containerClass?: string
  format?: string
  loading?: 'lazy' | 'eager'
  [key: string]: any
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  containerClass = '',
  ...restProps
} = Astro.props

const computedAspectRatio = width && height ? `${width} / ${height}` : undefined

// Identifica se a imagem pertence à CDN do Hygraph
const isHygraphImage =
  typeof src === 'string' && src.includes('graphassets.com')

let finalSrc = src
let isRemoteStatic = typeof src === 'string'

if (isHygraphImage && typeof src === 'string') {
  // Extrai a URL base limpando possíveis parâmetros existentes
  const baseUrl = src.split('?')[0]

  // Injeta a API de transformação nativa do Hygraph (Filestack)
  // Converte para WebP e redimensiona direto na CDN deles de forma gratuita
  const resizeParam =
    width && height ? `resize=width:${width},height:${height},fit:crop/` : ''
  finalSrc = baseUrl.replace(
    '://graphassets.com',
    `://graphassets.com${resizeParam}output=format:webp/`,
  )
}
---

<div
  class={`image-container skeleton ${containerClass}`}
  style={computedAspectRatio ? { aspectRatio: computedAspectRatio } : {}}>
  {
    isHygraphImage ? (
      // Se for Hygraph, renderiza a tag nativa usando a CDN deles. Zero downloads no GitHub Actions.
      <img
        src={finalSrc as string}
        alt={alt}
        width={width}
        height={height}
        class={`image-content ${className}`}
        loading={restProps.loading || 'lazy'}
        decoding="async"
        onload="this.closest('.image-container')?.classList.remove('skeleton')"
        {...restProps}
      />
    ) : (
      // Se for imagem local ou de outros domínios, mantém o comportamento padrão do Astro
      <Image
        src={src as any}
        alt={alt}
        width={width as any}
        height={height as any}
        class={`image-content ${className}`}
        onload="this.closest('.image-container')?.classList.remove('skeleton')"
        {...restProps}
      />
    )
  }
</div>

<script>
  document
    .querySelectorAll<HTMLImageElement>('.image-container .image-content')
    .forEach((img) => {
      if (img.complete) {
        img.closest('.image-container')?.classList.remove('skeleton')
      }
    })
</script>

<style>
  @reference "@/styles/global.css";

  .image-container.skeleton {
    @apply bg-slate-900/3 dark:bg-white/3;
    position: relative;
    overflow: hidden;
  }

  .image-container.skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.02) 20%,
      rgba(0, 0, 0, 0.06) 60%,
      transparent 100%
    );
    animation: shimmer 1.5s infinite;
    z-index: 10;
    pointer-events: none;
  }

  .dark .image-container.skeleton::after {
    background-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.03) 20%,
      rgba(255, 255, 255, 0.08) 60%,
      transparent 100%
    );
  }

  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
</style>
