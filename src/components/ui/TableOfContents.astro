---
import { Icon } from 'astro-icon/components'

interface Props {
  items: { id: string; title: string }[]
}

const { items } = Astro.props
---

<nav
  aria-label="Neste artigo"
  class="sticky top-(--ui-header-height) z-10 bg-default/75 lg:bg-[initial] backdrop-blur -mx-4 px-4 sm:px-6 sm:-mx-6 lg:ms-0 flex flex-col overflow-y-auto lg:overflow-hidden max-h-[calc(50vh-var(--ui-header-height))] lg:col-span-2 order-first lg:order-last">
  <div
    class="pt-4 sm:pt-6 pb-2.5 sm:pb-4.5 lg:py-8 border-b border-dashed border-default lg:border-0 flex flex-col lg:min-h-0">
    <!-- Mobile trigger -->
    <button
      type="button"
      id="toc-toggle"
      aria-expanded="false"
      aria-controls="toc-content"
      data-state="closed"
      class="group text-sm font-semibold flex-1 flex items-center gap-1.5 py-1.5 -mt-1.5 rounded-sm outline-primary/25 focus-visible:outline-3 lg:shrink-0 lg:hidden">
      <span class="truncate">Neste artigo</span>
      <span class="ms-auto inline-flex gap-1.5 items-center">
        <Icon
          name="mdi:chevron-down"
          class="size-5 transform transition-transform duration-200 shrink-0 group-data-[state=open]:rotate-180 lg:hidden"
        />
      </span>
    </button>

    <!-- Desktop static title -->
    <p
      class="group text-sm font-semibold flex-1 items-center gap-1.5 py-1.5 -mt-1.5 rounded-sm outline-primary/25 focus-visible:outline-3 lg:shrink-0 hidden lg:flex">
      <span class="truncate">Neste artigo</span>
      <span class="ms-auto inline-flex gap-1.5 items-center">
        <Icon
          name="mdi:chevron-down"
          class="size-5 transform transition-transform duration-200 shrink-0 lg:hidden"
        />
      </span>
    </p>

    <!-- Links -->
    <div
      id="toc-content"
      class="relative lg:min-h-0 lg:overflow-y-auto lg:scrollbar-none hidden lg:flex">
      <ul class="min-w-0">
        {
          items.map((item) => (
            <li class="min-w-0">
              <a
                href={`#${item.id}`}
                class="group relative text-sm flex items-center rounded-sm outline-primary/25 focus-visible:outline-3 py-1 text-muted hover:text-default transition-colors">
                <span class="truncate">{item.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  function setupTocToggle() {
    const toggle = document.getElementById('toc-toggle')
    const content = document.getElementById('toc-content')

    if (!toggle || !content) return

    // Remove listener antigo caso exista para evitar duplicidade
    toggle.replaceWith(toggle.cloneNode(true))
    const newToggle = document.getElementById('toc-toggle')

    newToggle?.addEventListener('click', () => {
      const isOpen = content.classList.toggle('hidden') === false
      newToggle.setAttribute('aria-expanded', String(isOpen))
      newToggle.setAttribute('data-state', isOpen ? 'open' : 'closed')
    })
  }

  // Executa no primeiro carregamento e a cada troca de página via View Transitions
  document.addEventListener('astro:page-load', setupTocToggle)
</script>
