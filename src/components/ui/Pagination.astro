---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

// Função para gerar os números das páginas com reticências (...)
function getPageNumbers(current: number, total: number) {
  const delta = 1; // Quantidade de páginas adjacentes a exibir
  const range: (number | string)[] = [];

  for (let i = 1; i <= total; i++) {
    if (
      i === 1 || // Primeira página
      i === total || // Última página
      (i >= current - delta && i <= current + delta) // Páginas vizinhas
    ) {
      range.push(i);
    } else if (range[range.length - 1] !== '...') {
      range.push('...');
    }
  }

  return range;
}

const pages = getPageNumbers(currentPage, totalPages);
---

<nav aria-label="Navegação da paginação" class="mt-12 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
  <!-- Botão Anterior -->
  {
    currentPage > 1 ? (
      <a
        href={currentPage === 2 ? '/blog' : `/blog/page/${currentPage - 1}`}
        class="inline-flex items-center justify-center rounded-lg border border-default px-2.5 py-2 text-sm font-medium transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-800 sm:px-4"
        aria-label="Anterior"
      >
        <span>←</span>
        <span class="ms-1.5 hidden sm:inline">Anterior</span>
      </a>
    ) : (
      <span
        class="inline-flex cursor-not-allowed opacity-40 items-center justify-center rounded-lg border border-default px-2.5 py-2 text-sm font-medium sm:px-4"
        aria-disabled="true"
      >
        <span>←</span>
        <span class="ms-1.5 hidden sm:inline">Anterior</span>
      </span>
    )
  }

  <!-- Números das Páginas -->
  {
    pages.map((page) => {
      if (page === '...') {
        return (
          <span class="flex h-9 w-8 items-center justify-center text-sm text-muted">
            …
          </span>
        );
      }

      const pageNumber = page as number;
      const isCurrent = pageNumber === currentPage;

      return (
        <a
          href={pageNumber === 1 ? '/blog' : `/blog/page/${pageNumber}`}
          aria-label={`Página ${pageNumber}`}
          aria-current={isCurrent ? 'page' : undefined}
          class:list={[
            'flex h-9 min-w-9 items-center justify-center rounded-lg border px-3 text-sm font-medium transition-colors',
            isCurrent
              ? 'border-transparent bg-zinc-900 text-white dark:bg-white dark:text-black font-semibold'
              : 'border-default hover:bg-zinc-100 dark:hover:bg-zinc-800',
          ]}
        >
          {pageNumber}
        </a>
      );
    })
  }

  <!-- Botão Próximo -->
  {
    currentPage < totalPages ? (
      <a
        href={`/blog/page/${currentPage + 1}`}
        class="inline-flex items-center justify-center rounded-lg border border-default px-2.5 py-2 text-sm font-medium transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-800 sm:px-4"
        aria-label="Próximo"
      >
        <span class="me-1.5 hidden sm:inline">Próximo</span>
        <span>→</span>
      </a>
    ) : (
      <span
        class="inline-flex cursor-not-allowed opacity-40 items-center justify-center rounded-lg border border-default px-2.5 py-2 text-sm font-medium sm:px-4"
        aria-disabled="true"
      >
        <span class="me-1.5 hidden sm:inline">Próximo</span>
        <span>→</span>
      </span>
    )
  }
</nav>