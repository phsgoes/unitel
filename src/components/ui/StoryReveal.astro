---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface StoryRevealItem {
  backgroundColor: string
  image: {
    src: ImageMetadata | string
    alt: string
    caption?: string
  }
  eyebrow: string
  title: string
  titleAccent: string
  accentColor: StoryRevealColor
  description: string
  secondaryDescription: string
  linkTo?: string
}

export type StoryRevealColor = 'zinc' | 'emerald' | 'blue' | 'rose' | 'slate'

interface Props {
  items: StoryRevealItem[]
  id?: string
}

const { items, id = `story-reveal-${Math.random().toString(36).slice(2, 9)}` } =
  Astro.props

const safeItems = items.slice(0, 20)

const themes: Record<
  StoryRevealColor,
  {
    text: string
    muted: string
    accent: string
    divider: string
    overlay: string
  }
> = {
  zinc: {
    text: 'text-white',
    muted: 'text-slate-100',
    accent: 'text-slate-300',
    divider: 'bg-white',
    overlay: 'bg-gradient-to-r from-black/20 to-transparent',
  },

  emerald: {
    text: 'text-white',
    muted: 'text-emerald-100',
    accent: 'text-emerald-300',
    divider: 'bg-emerald-400',
    overlay: 'bg-black/20',
  },

  blue: {
    text: 'text-white',
    muted: 'text-blue-100',
    accent: 'text-blue-300',
    divider: 'bg-blue-400',
    overlay: 'bg-black/20',
  },

  rose: {
    text: 'text-white',
    muted: 'text-rose-100',
    accent: 'text-rose-300',
    divider: 'bg-rose-400',
    overlay: 'bg-black/20',
  },

  slate: {
    text: 'text-white',
    muted: 'text-slate-100',
    accent: 'text-red-300',
    divider: 'bg-slate-300',
    overlay: 'bg-black/20',
  },
}

const getTheme = (color: StoryRevealColor) => themes[color] ?? themes.zinc
---

<section
  id={id}
  data-story-reveal
  data-story-count={safeItems.length}
  style={`--story-count: ${safeItems.length};`}
  class="story-stage bg-zinc-950"
  transition:persist>
  <div class="story-panel">
    {
      safeItems.map((item, index) => {
        const theme = getTheme(item.accentColor)

        return (
          <article
            class:list={['story-card', index === 0 ? 'is-active' : '']}
            data-story-card
            data-card-index={index}
            style={`background-color: ${item.backgroundColor}; z-index: ${index + 1};`}
            aria-hidden={index === 0 ? 'false' : 'true'}>
            <div class="flex flex-col h-full md:grid md:grid-cols-2">
              <div class="relative h-[36svh] sm:h-[40svh] md:h-full shrink-0 overflow-hidden">
                {typeof item.image.src === 'string' ? (
                  <img
                    src={item.image.src}
                    alt={item.image.alt}
                    width="1200"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <Image
                    src={item.image.src}
                    alt={item.image.alt}
                    widths={[480, 768, 1024, 1200]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    quality={75}
                    format="avif"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                )}

                <div class:list={['absolute inset-0', theme.overlay]} />

                {item.image.caption && (
                  <div class="absolute bottom-3 left-3 sm:bottom-6 sm:left-6 text-[10px] sm:text-xs font-bold uppercase tracking-[0.25em] bg-black/85 text-white rounded-lg border border-white/20 shadow-md backdrop-blur-xs">
                    <a
                      href={new URL(item.linkTo || '', Astro.site).href}
                      aria-label={`Item ${String(index + 1).padStart(2, '0')}: ${item.image.caption}`}
                      class="flex w-full h-full px-2.5 py-1.5 sm:p-3">
                      <span aria-hidden="true">
                        {String(index + 1).padStart(2, '0')} /
                      </span>
                      {item.image.caption}
                    </a>
                  </div>
                )}
              </div>

              <div
                class:list={[
                  'relative flex-1 min-h-0 flex flex-col justify-center overflow-y-auto px-6 py-5 sm:px-10 sm:py-8 md:px-12 md:py-12 lg:px-20',
                  theme.text,
                ]}
                style={`background-color: ${item.backgroundColor};`}>
                <div class="max-w-xl my-auto w-full">
                  <p
                    class:list={[
                      'mb-2 sm:mb-3 md:mb-5 text-xs font-bold uppercase tracking-[0.25em]',
                      theme.accent,
                    ]}>
                    {item.eyebrow}
                  </p>
                  <h2 class="text-2xl sm:text-3xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-tight">
                    {item.title}{' '}
                    <span class={theme.accent}>{item.titleAccent}</span>
                  </h2>
                  <p
                    class:list={[
                      'mt-3 sm:mt-4 md:mt-8 text-sm sm:text-base md:text-lg leading-relaxed',
                      theme.muted,
                    ]}>
                    {item.description}
                  </p>
                  <p
                    class:list={[
                      'mt-2 sm:mt-3 md:mt-5 text-xs sm:text-sm md:text-base leading-relaxed opacity-90',
                      theme.muted,
                    ]}>
                    {item.secondaryDescription}
                  </p>
                  <div
                    class:list={[
                      'mt-3 sm:mt-6 md:mt-10 h-px w-16 sm:w-24',
                      theme.divider,
                    ]}
                  />
                </div>
              </div>
            </div>
          </article>
        )
      })
    }
  </div>
</section>

<style>
  .story-stage {
    position: relative;
    height: calc(var(--story-count, 5) * 100svh);
  }

  .story-panel {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    overflow: hidden;
  }

  .story-card {
    position: absolute;
    inset: 0;
    transform: translate3d(0, 100%, 0);
    opacity: 0;
    will-change: transform, opacity;
    pointer-events: none;
    backface-visibility: hidden;
    transform-origin: center center;
  }

  .story-card.is-active {
    pointer-events: auto;
  }

  .story-card img {
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (max-width: 768px) {
    .story-stage {
      height: calc(100svh + (var(--story-count, 5) - 1) * 85svh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-card {
      will-change: auto;
    }
  }
</style>

<script>
  const INITIALIZED_ATTRIBUTE = 'data-story-reveal-initialized'
  if (!document.documentElement.hasAttribute(INITIALIZED_ATTRIBUTE)) {
    document.documentElement.setAttribute(INITIALIZED_ATTRIBUTE, '')

    const clamp = (value: number, min: number, max: number) => {
      return Math.min(Math.max(value, min), max)
    }

    const components = new Set<HTMLElement>()

    type StoryRevealState = HTMLElement & {
      __storyRevealCards?: HTMLElement[]
      __storyRevealCount?: number
    }

    function initializeComponent(container: HTMLElement) {
      const cards = Array.from(
        container.querySelectorAll<HTMLElement>('[data-story-card]'),
      )
      if (!cards.length) return
      const state = container as StoryRevealState
      state.__storyRevealCards = cards
      state.__storyRevealCount = cards.length
    }

    function collectComponents() {
      components.clear()
      document
        .querySelectorAll<HTMLElement>('[data-story-reveal]')
        .forEach((element) => {
          initializeComponent(element)
          components.add(element)
        })
    }

    function updateComponent(container: HTMLElement) {
      const state = container as StoryRevealState
      let cards = state.__storyRevealCards
      if (!cards?.length) {
        initializeComponent(container)
        cards = state.__storyRevealCards
        if (!cards?.length) return
      }

      const count = cards.length
      if (count <= 1) {
        if (cards[0]) {
          cards[0].style.opacity = '1'
          cards[0].style.transform = 'translate3d(0, 0, 0) scale(1)'
          cards[0].classList.add('is-active')
          cards[0].setAttribute('aria-hidden', 'false')
        }
        return
      }

      const rect = container.getBoundingClientRect()
      const totalScroll = container.offsetHeight - window.innerHeight
      if (totalScroll <= 0) return

      const passed = clamp(-rect.top, 0, totalScroll)
      const progress = passed / totalScroll
      const numTransitions = count - 1
      const globalProgress = progress * numTransitions
      const activeIndex = clamp(
        Math.floor(globalProgress),
        0,
        numTransitions - 1,
      )
      const localProgress = clamp(globalProgress - activeIndex, 0, 1)

      cards.forEach((card, index) => {
        if (index < activeIndex) {
          card.style.opacity = '0'
          card.style.transform = 'translate3d(0, -5%, 0) scale(0.94)'
          card.classList.remove('is-active')
          card.setAttribute('aria-hidden', 'true')
          return
        }

        if (index > activeIndex + 1) {
          card.style.opacity = '0'
          card.style.transform = 'translate3d(0, 100%, 0) scale(1)'
          card.classList.remove('is-active')
          card.setAttribute('aria-hidden', 'true')
          return
        }

        if (index === activeIndex) {
          const leaving = localProgress
          const scale = 1 - leaving * 0.06
          const opacity = Math.max(0, 1 - leaving * 0.95)
          card.style.opacity = String(opacity)
          card.style.transform = `translate3d(0, ${-leaving * 5}%, 0) scale(${scale})`
          if (localProgress < 0.5) {
            card.classList.add('is-active')
            card.setAttribute('aria-hidden', 'false')
          } else {
            card.classList.remove('is-active')
            card.setAttribute('aria-hidden', 'true')
          }
          return
        }

        if (index === activeIndex + 1) {
          const entering = localProgress
          const translateY = (1 - entering) * 100
          card.style.opacity = String(entering)
          card.style.transform = `translate3d(0, ${translateY}%, 0) scale(1)`
          if (localProgress >= 0.5) {
            card.classList.add('is-active')
            card.setAttribute('aria-hidden', 'false')
          } else {
            card.classList.remove('is-active')
            card.setAttribute('aria-hidden', 'true')
          }
          return
        }
      })
    }

    function updateAll() {
      components.forEach(updateComponent)
    }

    let ticking = false

    function requestUpdate() {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        updateAll()
        ticking = false
      })
    }

    let isVisible = false
    const observer = typeof IntersectionObserver !== 'undefined'
      ? new IntersectionObserver(
          (entries) => {
            const hasVisible = entries.some((entry) => entry.isIntersecting)
            if (hasVisible && !isVisible) {
              isVisible = true
              window.addEventListener('scroll', requestUpdate, { passive: true })
              requestUpdate()
            } else if (!hasVisible && isVisible) {
              isVisible = false
              window.removeEventListener('scroll', requestUpdate)
            }
          },
          { rootMargin: '200px 0px' },
        )
      : null

    function setupObserver() {
      collectComponents()
      if (observer) {
        components.forEach((c) => observer.observe(c))
      } else {
        window.addEventListener('scroll', requestUpdate, { passive: true })
        requestUpdate()
      }
    }

    window.addEventListener(
      'resize',
      () => {
        collectComponents()
        if (isVisible) requestUpdate()
      },
      { passive: true },
    )

    document.addEventListener('astro:page-load', () => {
      setupObserver()
    })
    document.addEventListener('astro:after-swap', () => {
      setupObserver()
    })

    setupObserver()
  }
</script>
