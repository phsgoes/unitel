---
// src/components/SearchController.astro
---

<script>
  import type Fuse from 'fuse.js'
  import type { SearchPost } from '@/types'

  let fuseInstance: Fuse<SearchPost> | null = null
  let isFetching = false

  async function initFuse() {
    if (fuseInstance || isFetching) return
    isFetching = true

    try {
      const [{ default: FuseModule }, response] = await Promise.all([import('fuse.js'), fetch('/search.json')])
      const posts: SearchPost[] = await response.json()

      fuseInstance = new FuseModule(posts, {
        keys: ['title', 'description', 'categories.name'],
        threshold: 0.35, // Sensibilidade da busca
        ignoreLocation: true,
      })
    } catch (error) {
      console.error('Erro ao carregar dados da busca:', error)
    } finally {
      isFetching = false
    }
  }

  function setupSearchLogic() {
    const input = document.getElementById('blog-search-input') as HTMLInputElement | null
    const grid = document.getElementById('posts-grid')
    const pagination = document.getElementById('pagination-container')

    if (!input || !grid) return

    // Guarda o HTML original do grid e da paginação para restaurar quando o campo for limpo
    const originalGridHTML = grid.innerHTML
    const originalPaginationDisplay = pagination ? pagination.style.display : ''

    // Pré-carrega o índice ao passar o mouse ou focar no input
    input.addEventListener('focus', initFuse, { once: true })
    input.addEventListener('mouseenter', initFuse, { once: true })

    input.addEventListener('input', async (e) => {
      const query = (e.target as HTMLInputElement).value.trim()

      if (!query) {
        grid.innerHTML = originalGridHTML
        if (pagination) pagination.style.display = originalPaginationDisplay
        return
      }

      if (!fuseInstance) await initFuse()
      if (!fuseInstance) return

      const results = fuseInstance.search(query)

      // Oculta a paginação padrão durante a busca ativa
      if (pagination) pagination.style.display = 'none'

      if (results.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-12 text-center text-muted">
            Nenhum artigo encontrado para "<span class="font-semibold text-highlighted">${query}</span>".
          </div>
        `
        return
      }

      // Renderiza os resultados buscados no grid
      grid.innerHTML = results
        .map(({ item }) => {
          const categories = item.categories?.map((c) => c.name).join(' · ') || 'Sem categoria'
          return `
            <article class="group relative flex flex-col items-start justify-between rounded-2xl border border-default p-6 transition-colors hover:bg-elevated/50">
              <div>
                <div class="flex items-center gap-x-2 text-xs font-semibold text-primary mb-2">
                  <span>${categories}</span>
                </div>
                <h2 class="text-xl font-bold tracking-tight text-highlighted group-hover:text-primary transition-colors">
                  <a href="/blog/${item.slug}/">
                    <span class="absolute inset-0"></span>
                    ${item.title}
                  </a>
                </h2>
                <p class="mt-3 text-sm line-clamp-2 text-muted">
                  ${item.description}
                </p>
              </div>
            </article>
          `
        })
        .join('')
    })
  }

  document.addEventListener('astro:page-load', setupSearchLogic)
</script>
