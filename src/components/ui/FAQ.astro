---
import { Icon } from 'astro-icon/components'

export interface FAQItem {
  question: string
  answer: string
}

interface Props {
  items: FAQItem[]
  title?: string
  description?: string
  badge?: boolean
  badgeClasses?: string
}

const {
  items,
  title = 'Perguntas frequentes',
  description = 'Tire suas principais dúvidas sobre a solução.',
  badge = true,
  badgeClasses = 'border-orange-200 bg-orange-50 text-orange-700 dark:border-orange-800/60 dark:bg-orange-950/50 dark:text-orange-300',
} = Astro.props
---

<section id="faq" class="bg-default py-20 sm:py-24" aria-labelledby="faq-title">
  <div class="mx-auto max-w-4xl px-6 lg:px-8">
    <header class="mb-10 max-w-2xl">
      {
        badge && (
          <span
            class:list={[
              'mb-4 inline-flex items-center rounded-full border  px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em]',
              badgeClasses,
            ]}>
            FAQ
          </span>
        )
      }

      <h2
        id="faq-title"
        class="text-3xl font-bold tracking-tight text-default sm:text-4xl">
        {title}
      </h2>

      <p class="mt-4 text-base leading-7 text-toned sm:text-lg">
        {description}
      </p>
    </header>
    <div
      class="-mx-4 -my-2 space-y-0 divide-y divide-gray-200 dark:divide-gray-700">
      {
        items.map((item, index) => (
          <details class="group px-4 py-3 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium text-gray-900 hover:text-gray-700 dark:text-white dark:hover:text-gray-200">
              <span>{item.question}</span>
              <svg
                aria-hidden="true"
                class="size-5 shrink-0 transition-transform duration-300 group-open:-rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>

            <div class="py-4">
              <p class="text-gray-700 dark:text-gray-200">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }

  .faq-item > summary::marker {
    display: none;
  }

  .faq-item[open] .faq-answer {
    /* Keeps the open state smooth without JavaScript. */
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer,
    .faq-item span {
      transition: none !important;
    }
  }
</style>
