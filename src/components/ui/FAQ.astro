---
import { Icon } from 'astro-icon/components'

export interface FAQItem {
  question: string
  answer: string
}

interface Props {
  items: FAQItem[]
  title?: string
  description?: string
  badge?: boolean
  badgeClasses?: string
}

const {
  items,
  title = 'Perguntas frequentes',
  description = 'Tire suas principais dúvidas sobre a solução.',
  badge = true,
  badgeClasses = 'border-orange-200 bg-orange-50 text-orange-600',
} = Astro.props
---

<section id="faq" class="bg-default py-20 sm:py-24" aria-labelledby="faq-title">
  <div class="mx-auto max-w-4xl px-6 lg:px-8">
    <header class="mb-10 max-w-2xl">
      {
        badge && (
          <span
            class:list={[
              'mb-4 inline-flex items-center rounded-full border  px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em]',
              badgeClasses,
            ]}>
            FAQ
          </span>
        )
      }

      <h2
        id="faq-title"
        class="text-3xl font-bold tracking-tight text-default sm:text-4xl">
        {title}
      </h2>

      <p class="mt-4 text-base leading-7 text-toned sm:text-lg">
        {description}
      </p>
    </header>

    <div
      class="divide-y divide-default rounded-2xl border border-default bg-default">
      {
        items.map((item, index) => (
          <details
            class:list={[
              'group faq-item',
              index + 1 < items.length && 'border-b border-default',
            ]}
            open={index === 0 ? false : undefined}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-5 py-5 text-left font-semibold text-default transition-colors duration-200 hover:text-orange-600 sm:px-6">
              <span class="text-base leading-6 sm:text-lg">
                {item.question}
              </span>

              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full border border-default bg-default text-default transition-all duration-300 group-open:rotate-45 group-open:border-orange-200 group-open:bg-orange-50 group-open:text-orange-600"
                aria-hidden="true">
                <Icon name="mdi:plus" width={18} height={18} />
              </span>
            </summary>

            <div class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-open:grid-rows-[1fr]">
              <div class="overflow-hidden">
                <div class="px-5 pb-6 pr-16 text-sm leading-7 text-toned sm:px-6 sm:pr-20 sm:text-base">
                  {item.answer}
                </div>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }

  .faq-item > summary::marker {
    display: none;
  }

  .faq-item[open] .faq-answer {
    /* Keeps the open state smooth without JavaScript. */
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer,
    .faq-item span {
      transition: none !important;
    }
  }
</style>
