const imageGlob = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/clientes/**/*.avif', {
  eager: true,
})

const resolveClients = (segment: string) =>
  clients
    .filter((client) => client.path.includes(segment))
    .map((client) => {
      const module = imageGlob[client.path]
      return {
        ...client,
        src: module ? module.default : (client.path as unknown as ImageMetadata),
      }
    })

const healthClients = resolveClients('/saude/')
const commercialClients = resolveClients('/comercial/')
