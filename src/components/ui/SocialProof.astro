<script>
  function initSocialProof() {
    const section = document.getElementById('social-proof')
    if (!section) return

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-running')
            } else {
              section.classList.remove('is-running')
            }
          })
        },
        { rootMargin: '100px 0px' },
      )
      observer.observe(section)
    } else {
      section.classList.add('is-running')
    }

    const items = section.querySelectorAll('.client-item')
    items.forEach((item) => {
      const handleTouchStart = () => {
        items.forEach((i) => i.classList.remove('is-touched'))
        item.classList.add('is-touched')
      }

      const handleTouchEnd = () => {
        item.classList.remove('is-touched')
      }

      item.addEventListener('pointerdown', handleTouchStart, { passive: true })
      item.addEventListener('pointerup', handleTouchEnd, { passive: true })
      item.addEventListener('pointercancel', handleTouchEnd, { passive: true })
      item.addEventListener('pointerleave', handleTouchEnd, { passive: true })
    })
  }

  initSocialProof()
  document.addEventListener('DOMContentLoaded', initSocialProof)
  document.addEventListener('astro:page-load', initSocialProof)
  document.addEventListener('astro:after-swap', initSocialProof)
</script>

<style>
  /* Mantém o estado da animação sincronizado durante a troca de páginas */
  .marquee-container {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  /* Impede que o estado da animação CSS reset dessincronizado */
  .marquee-left,
  .marquee-right {
    view-transition-name: unset;
  }

  .client-item {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    touch-action: manipulation;
  }

  .mask-gradient::before,
  .mask-gradient::after {
    content: '';
    position: absolute;
    top: 0;
    z-index: 10;
    height: 100%;
    width: 3rem;
    pointer-events: none;
  }

  .mask-gradient::before {
    left: 0;
    background: linear-gradient(to right, var(--mask-color, #ffffff), transparent);
  }

  .mask-gradient::after {
    right: 0;
    background: linear-gradient(to left, var(--mask-color, #ffffff), transparent);
  }

  :global(.dark) .mask-gradient {
    --mask-color: #0f172b;
  }

  @media (min-width: 768px) {
    .mask-gradient::before,
    .mask-gradient::after {
      width: 6rem;
    }
  }

  @media (hover: hover) {
    .marquee-container:hover {
      animation-play-state: paused !important;
    }
  }

  .marquee-left {
    animation: scroll-left var(--animation-duration, 30s) linear infinite;
    animation-play-state: paused;
  }

  .marquee-right {
    animation: scroll-right var(--animation-duration, 30s) linear infinite;
    animation-play-state: paused;
  }

  :global(.is-running) .marquee-left,
  :global(.is-running) .marquee-right {
    animation-play-state: running;
  }

  @keyframes scroll-left {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-left,
    .marquee-right {
      animation-play-state: paused !important;
    }
  }
</style>
