---
const gaId = import.meta.env.PUBLIC_GA4_ID
---

{gaId && (
  <script is:inline define:vars={{ gaId }}>
    (() => {
      if (window.__UNITEL_GA_INITIALIZED__) return

      window.__UNITEL_GA_INITIALIZED__ = true

      window.dataLayer = window.dataLayer || []

      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments)
        }

      window.gtag('js', new Date())

      window.gtag('config', gaId, {
        send_page_view: false,
      })

      const loadGoogleAnalytics = () => {
        if (
          document.querySelector(
            `script[data-ga4="${gaId}"]`,
          )
        ) {
          return
        }

        const script = document.createElement('script')

        script.async = true
        script.src =
          `https://www.googletagmanager.com/gtag/js?id=${gaId}`

        script.dataset.ga4 = gaId

        document.head.appendChild(script)
      }

      const triggerEvents = ['pointerdown', 'touchstart', 'scroll', 'keydown']
      const onInteraction = () => {
        triggerEvents.forEach((ev) => window.removeEventListener(ev, onInteraction))
        loadGoogleAnalytics()
      }
      triggerEvents.forEach((ev) => window.addEventListener(ev, onInteraction, { passive: true, once: true }))

      if (document.readyState === 'complete') {
        setTimeout(loadGoogleAnalytics, 4000)
      } else {
        window.addEventListener('load', () => {
          setTimeout(loadGoogleAnalytics, 4000)
        })
      }

      document.addEventListener('astro:page-load', () => {
        window.gtag('event', 'page_view', {
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname,
        })
      })
    })()
  </script>
)}

